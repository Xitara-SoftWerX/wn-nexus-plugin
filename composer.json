{
    "name": "xitara/wn-nexus-plugin",
    "type": "winter-plugin",
    "description": "Nexus Winter CMS plugin",
    "keywords": [
        "winter",
        "cms",
        "nexus",
        "plugin"
    ],
    "license": "MPL-2.0",
    "authors": [
        {
            "name": "Manuel Burghammer",
            "email": "mb@xitara.com",
            "role": "Author"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer/installers": "^1.11"
    },
    "conflict": {
        "winter/wn-backend-module": "<1.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpdocumentor/shim": "*"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "phpdocumentor/shim": true
        }
    }
}

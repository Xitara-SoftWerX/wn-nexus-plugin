{
    "name": "xitara/wn-nexus-plugin",
    "type": "winter-plugin",
    "description": "Nexus Winter CMS plugin",
    "keywords": ["winter", "cms", "nexus", "plugin"],
    "license": "MPL-2.0",
    "authors": [
        {
            "name": "Manuel Burghammer",
            "email": "mb@xitara.com",
            "role": "Author"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "composer/installers": "^2.3.0",
        "sabberworm/php-css-parser": "^8.4",
        "chillerlan/php-qrcode": "^4.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpdocumentor/shim": "*"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "phpdocumentor/shim": true
        }
    }
}
